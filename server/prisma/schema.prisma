generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  level        Int       @default(1)
  xpTotal      Int       @default(0)
  streakDays   Int       @default(0)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  cohortId     String?
  cohort       Cohort?   @relation(fields: [cohortId], references: [id])

  gameSessions     GameSession[]
  masteryScores    MasteryScore[]
  tests            Test[]
  studyPlans       StudyPlan[]
  domainProgress   UserDomainProgress[]
  userAchievements UserAchievement[]
  interviewProgress UserInterviewProgress[]
  testAttempts     TestAttempt[]
  aiInterviews     AiInterview[]
  createdTests     AssessmentTest[] @relation("CreatedTests")
  friendRequests   Friendship[]     @relation("FriendRequests")
  friendOf         Friendship[]     @relation("FriendOf")
  problemStatuses  UserProblemStatus[]
  quests           UserQuest[]
  placementDrives  PlacementDrive[]
  skillProfile     UserSkillProfile?
  diagnosticAttempts DiagnosticAttempt[]
  learningPipelines LearningPipeline[]
  testReports      TestReport[]
}

enum Role {
  STUDENT
  COLLEGE_STUDENT
  EDUCATOR
  ADMIN
}

// Topics define the taxonomy Claude uses to generate questions.
// They do NOT hold questions — they are navigation nodes only.
model Topic {
  id        String   @id @default(uuid())
  subject   String   // e.g. "Physics"
  topic     String   // e.g. "Thermodynamics"
  subtopic  String   // e.g. "Carnot cycle"  ← this is what Claude receives
  isActive  Boolean  @default(true)
  domainId  String?
  domain    Domain?  @relation(fields: [domainId], references: [id])
  levelOrder Int     @default(1)    // 1=beginner, 2, 3... higher=harder
  createdAt DateTime @default(now())

  gameSessions  GameSession[]
  masteryScores MasteryScore[]
  studyPlans    StudyPlan[]
}

// Stores session metadata only. No question content.
model GameSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  gameType    GameType @default(MCQ)
  difficulty  Int      @default(2)
  score       Int      @default(0)
  xpEarned    Int      @default(0)
  durationSec Int      @default(0)
  playedAt    DateTime @default(now())

  attempts QuestionAttempt[]
}

enum GameType {
  MCQ
  MEMORY_MATCH
  WORD_SCRAMBLE
  CROSSWORD
  HANGMAN
  FILL_BLANK
  CONCEPT_CANNON
}

// Stores per-question result without storing the question itself.
// questionHash = sha256(questionText).slice(0,16) — deterministic, reproducible.
model QuestionAttempt {
  id           String      @id @default(uuid())
  sessionId    String
  session      GameSession @relation(fields: [sessionId], references: [id])
  questionHash String      // identifies the question without storing it
  subtopic     String      // copied from topic for fast mastery queries
  difficulty   Int
  isCorrect    Boolean
  timeTakenMs  Int
  hintUsed     Boolean     @default(false)
}

model MasteryScore {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id])
  score        Float    @default(0)
  isWeak       Boolean  @default(false)
  attemptCount Int      @default(0)
  nextReviewAt DateTime?
  lastUpdated  DateTime @default(now())

  @@unique([userId, topicId])
}

model Test {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  testType    String   @default("mixed")
  subject     String
  totalMarks  Int
  scoredMarks Int
  timeLimitMin Int     @default(30)
  questionCount Int    @default(30)
  takenAt     DateTime @default(now())

  testQuestions TestQuestion[]
}

// Test questions are also AI-generated. Store result only.
model TestQuestion {
  id           String  @id @default(uuid())
  testId       String
  test         Test    @relation(fields: [testId], references: [id])
  questionHash String
  subtopic     String  // critical — weakness detection reads this
  topicArea    String  @default("aptitude")
  difficulty   Int
  isCorrect    Boolean
  marksAwarded Int     @default(0)
}

model StudyPlan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  priority    Priority @default(MEDIUM)
  isCompleted Boolean  @default(false)
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, topicId])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Domain {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  icon        String
  description String
  color       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  topics       Topic[]
  userProgress UserDomainProgress[]
}

model UserDomainProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  domainId        String
  domain          Domain   @relation(fields: [domainId], references: [id])
  currentLevel    Int      @default(1)
  totalXpInDomain Int      @default(0)
  rank            String   @default("Bronze Coder")
  updatedAt       DateTime @updatedAt

  @@unique([userId, domainId])
}

model Achievement {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  category    String
  xpReward    Int      @default(0)
  condition   String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ===== INTERVIEW PREP MODELS =====

model InterviewCategory {
  id          String   @id @default(uuid())
  section     String   // "A", "B", "C"
  name        String   // "Quantitative Aptitude", "Logical Reasoning", "Verbal Ability"
  slug        String   @unique // "quantitative-aptitude", "logical-reasoning", "verbal-ability"
  icon        String   // emoji
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  topics    InterviewTopic[]
}

model InterviewTopic {
  id          String   @id @default(uuid())
  name        String   // "Number System", "Percentages", "Calendars", etc.
  slug        String   // "number-system"
  categoryId  String
  category    InterviewCategory @relation(fields: [categoryId], references: [id])
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  questions   InterviewQuestion[]
  theory      InterviewTheory?
  progress    UserInterviewProgress[]

  @@unique([categoryId, slug])
}

model InterviewQuestion {
  id              String   @id @default(uuid())
  topicId         String
  topic           InterviewTopic @relation(fields: [topicId], references: [id])
  questionNumber  Int
  question        String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  optionE         String?
  correctAnswer   String   // "A", "B", "C", "D" — from solved JSON
  correctIndex    Int      // 0-indexed — from solved JSON
  difficulty      String   @default("medium") // easy, medium, hard
  sourceRef       String?  // "The Aptitude Triad"
  createdAt       DateTime @default(now())
  // false = quality scan flagged this question as broken (missing context,
  // orphaned "A/B/…" references, PDF-parse artifacts). Read paths filter to
  // isValid: true. Set by scripts/flag-invalid-aptitude.ts.
  isValid         Boolean  @default(true)
  invalidReason   String?
}

model InterviewTheory {
  id              String   @id @default(uuid())
  topicId         String   @unique
  topic           InterviewTopic @relation(fields: [topicId], references: [id])
  rawTheory       String   // full theory text from JSON
  keyPoints       Json     // string[] from quick_notes.keyPoints
  formulas        Json     // string[] from quick_notes.formulas
  tutorialSections Json    // [{heading, content}] from tutorial_sections
  formulaCount    Int      @default(0)
  exampleCount    Int      @default(0)
  conceptCount    Int      @default(0)
  cleanedAt       DateTime?
}

model UserInterviewProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  topicId     String
  topic       InterviewTopic @relation(fields: [topicId], references: [id])
  gamesPlayed Int      @default(0)
  bestScore   Int      @default(0)
  avgScore    Float    @default(0)
  totalXp     Int      @default(0)
  lastPlayedAt DateTime?
  lastIntegrity Json?   // last practice session's integrity summary { counts, signal } — non-punitive

  @@unique([userId, topicId])
}

// ===== ASSESSMENT PLATFORM (proctored tests + AI interview) =====
// Named Assessment* to avoid collision with the legacy Topic/Test/Question
// models above, which belong to the game arcade and store results only.

enum AssessmentCategory {
  QUANTITATIVE
  LOGICAL
  VERBAL
  CODING
  TECHNICAL
}

enum AssessmentQuestionType {
  SINGLE
  MULTI
  FILL
  TRUE_FALSE
}

enum AssessmentDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentTestMode {
  PRACTICE
  PROCTORED
}

enum AssessmentTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestSectionKind {
  APTITUDE
  VERBAL
  LOGICAL
  CODING
  MIXED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ProctoringEventType {
  TAB_BLUR
  TAB_FOCUS
  FULLSCREEN_EXIT
  COPY
  PASTE
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  NO_CAMERA
  SNAPSHOT
}

enum AiInterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AiInterviewTurnRole {
  INTERVIEWER
  CANDIDATE
}

model AssessmentTopic {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  category  AssessmentCategory
  parentId  String?
  parent    AssessmentTopic?   @relation("AssessmentTopicTree", fields: [parentId], references: [id])
  children  AssessmentTopic[]  @relation("AssessmentTopicTree")
  order     Int                @default(0)
  createdAt DateTime           @default(now())

  questions      AssessmentQuestion[]
  codingProblems CodingProblem[]
}

model AssessmentQuestion {
  id             String                 @id @default(uuid())
  topicId        String
  topic          AssessmentTopic        @relation(fields: [topicId], references: [id])
  type           AssessmentQuestionType @default(SINGLE)
  difficulty     AssessmentDifficulty   @default(MEDIUM)
  stem           String // markdown
  assets         Json? // images/tables/figures; assets.requiresImage = true for figure-based items
  explanation    String? // worked solution (from solve-and-verify or human)
  proposedAnswer String? // option letter proposed by AI solver, pending human confirmation
  source         String?
  sourceUrl      String?
  verified       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  options      AssessmentOption[]
  sectionItems TestSectionItem[]
  responses    AttemptResponse[]
}

model AssessmentOption {
  id         String             @id @default(uuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean            @default(false)
  order      Int                @default(0)
}

model CodingProblem {
  id                String               @id @default(uuid())
  topicId           String
  topic             AssessmentTopic      @relation(fields: [topicId], references: [id])
  title             String
  slug              String               @unique
  statement         String // markdown — our own restated statement, never scraped text
  difficulty        AssessmentDifficulty @default(MEDIUM)
  constraints       String?
  sampleIo          Json? // [{ input, output, explanation? }]
  starterCode       Json? // keyed by language: { cpp, java, python, javascript }
  referenceSolution Json? // keyed by language
  timeLimitMs       Int                  @default(2000)
  memoryLimitMb     Int                  @default(256)
  source            String?
  sourceUrl         String? // attribution link (e.g. A2Z sheet item)
  companies         String[]             @default([]) // company slugs this problem is tagged for (e.g. ["amazon","microsoft"])
  track             String? // coding-track slug (defaults to topic slug), e.g. "arrays"
  level             Int                  @default(1) // 1=easy warmup … 4=hard; drives the track map
  verified          Boolean              @default(false) // true once reference solution passes all test cases
  createdAt         DateTime             @default(now())

  testCases    TestCase[]
  sectionItems TestSectionItem[]
  responses    AttemptResponse[]
  userStatuses UserProblemStatus[]
}

model TestCase {
  id              String        @id @default(uuid())
  codingProblemId String
  codingProblem   CodingProblem @relation(fields: [codingProblemId], references: [id], onDelete: Cascade)
  input           String
  expectedOutput  String
  isSample        Boolean       @default(false)
  weight          Int           @default(1)
}

model Company {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  logoUrl String?
  notes   String?
  profile Json? // pattern profile: topic weights, difficulty mix, round structure, interview style

  tests           AssessmentTest[]
  interviews      AiInterview[]
  questions       CompanyQuestion[]
  placementDrives PlacementDrive[]
}

// Company-specific TECHNICAL / SYSTEM_DESIGN interview questions (non-coding).
// Concept-based prompts an interviewer might open a technical round with
// ("What is virtual memory?", "Explain ACID"). Bank-style — not proctored.
model CompanyQuestion {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  category   String // TECHNICAL | SYSTEM_DESIGN
  subject    String? // OS | DBMS | OOPS | CN | DSA | SYSTEM_DESIGN
  question   String
  answerHint String? // markdown: talking points / model answer
  difficulty String   @default("medium") // easy | medium | hard
  tags       String[] @default([]) // sub-topics (e.g. ["indexing","normalization"])
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([companyId, category])
}

model AssessmentTest {
  id              String               @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int                  @default(90) // free integer; UI offers 90 / 180 presets
  mode            AssessmentTestMode   @default(PRACTICE)
  companyId       String?
  company         Company?             @relation(fields: [companyId], references: [id])
  randomizeOrder  Boolean              @default(false)
  negativeMarking Float                @default(0) // marks deducted per wrong answer
  passScore       Int?
  createdById     String?
  createdBy       User?                @relation("CreatedTests", fields: [createdById], references: [id])
  status          AssessmentTestStatus @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  sections TestSection[]
  attempts TestAttempt[]
  contest  Contest?
}

model TestSection {
  id               String          @id @default(uuid())
  testId           String
  test             AssessmentTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  title            String
  kind             TestSectionKind
  selectionRule    Json? // e.g. { strategy: "ONE_PER_TOPIC", category, difficultyMix, verifiedOnly }
  marksPerQuestion Float           @default(1)
  order            Int             @default(0)

  items TestSectionItem[]
}

// Fixed/pinned items in a section. Dynamic items come from selectionRule at attempt start.
model TestSectionItem {
  id              String              @id @default(uuid())
  sectionId       String
  section         TestSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId      String?
  question        AssessmentQuestion? @relation(fields: [questionId], references: [id])
  codingProblemId String?
  codingProblem   CodingProblem?      @relation(fields: [codingProblemId], references: [id])
  order           Int                 @default(0)
}

model TestAttempt {
  id              String         @id @default(uuid())
  testId          String
  test            AssessmentTest @relation(fields: [testId], references: [id])
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  startedAt       DateTime       @default(now())
  submittedAt     DateTime?
  status          AttemptStatus  @default(IN_PROGRESS)
  durationUsedSec Int            @default(0)
  score           Float?
  breakdown       Json? // per-section / per-topic score breakdown
  itemsSnapshot   Json? // resolved ordered item list, frozen at attempt start
  consentAt       DateTime? // proctoring consent timestamp (required for PROCTORED)

  responses        AttemptResponse[]
  proctoringEvents ProctoringEvent[]

  @@index([testId, userId])
}

model AttemptResponse {
  id              String              @id @default(uuid())
  attemptId       String
  attempt         TestAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String?
  question        AssessmentQuestion? @relation(fields: [questionId], references: [id])
  codingProblemId String?
  codingProblem   CodingProblem?      @relation(fields: [codingProblemId], references: [id])
  answer          Json? // MCQ: chosen option id(s); coding: { language, code, lastRun }
  isCorrect       Boolean?
  marks           Float               @default(0)
  timeSpentSec    Int                 @default(0)
  flagged         Boolean             @default(false)
  updatedAt       DateTime            @updatedAt

  @@unique([attemptId, questionId])
  @@unique([attemptId, codingProblemId])
}

model ProctoringEvent {
  id          String              @id @default(uuid())
  attemptId   String
  attempt     TestAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type        ProctoringEventType
  meta        Json?
  snapshotUrl String?
  createdAt   DateTime            @default(now())

  @@index([attemptId, createdAt])
}

// Conversational AI interview — distinct from the InterviewCategory/InterviewTopic
// MCQ prep module above.
model AiInterview {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  role                String // e.g. "SDE", "Backend"
  roundType           String            @default("technical") // "hr" | "technical" | "coding" | "full"
  companyId           String?
  company             Company?          @relation(fields: [companyId], references: [id])
  status              AiInterviewStatus @default(IN_PROGRESS)
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  overallScore        Float?
  rubricScores        Json? // { technical, communication, structure, problemSolving, roleFit } 0–5 each
  summary             String?
  proctoringSummary   Json? // face-presence event counts from the video interview — signal, not verdict
  deliverySignals     Json? // speech-delivery cues (avgWpm, totalFillers, per-answer) — informational, not scored
  resumeData          Json? // extracted resume skills/projects/experience
  selectedQuestionIds String[]          @default([])

  turns     AiInterviewTurn[]
  diagnosis InterviewDiagnosis?
}

model AiInterviewTurn {
  id            String              @id @default(uuid())
  interviewId   String
  interview     AiInterview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role          AiInterviewTurnRole
  content       String
  audioUrl      String?
  turnScore     Float?
  feedback      String?
  starBreakdown Json? // STAR structure evaluation for HR round
  order         Int
  isFollowup    Boolean             @default(false) // interviewer probe on the previous answer (doesn't consume the question budget)

  @@index([interviewId, order])
}

// Core CS MCQ Question Bank (CN, OS, DBMS, SQL from data.json)
model CoreSubjectQuestion {
  id          String   @id @default(uuid())
  subject     String // "CN", "OS", "DBMS", "SQL"
  question    String
  options     Json // string[]
  answerIndex Int // 0-indexed correct answer
  explanation String
  difficulty  String   @default("medium")
  tags        String[] @default([])
  createdAt   DateTime @default(now())

  @@index([subject])
}

// ===== SOCIAL & CONTESTS (Pillar D) =====

model Cohort {
  id        String   @id @default(uuid())
  name      String // "PSG Tech — CSE 2026"
  slug      String   @unique
  joinCode  String   @unique // students join with this code
  createdAt DateTime @default(now())

  members  User[]
  contests Contest[]
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String       @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  requester   User         @relation("FriendRequests", fields: [requesterId], references: [id])
  addressee   User         @relation("FriendOf", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Contest {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?
  testId      String         @unique
  test        AssessmentTest @relation(fields: [testId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  cohortId    String? // null = open to everyone; set = cohort-only
  cohort      Cohort?        @relation(fields: [cohortId], references: [id])
  settledAt   DateTime? // placement XP awarded once after endsAt
  createdAt   DateTime       @default(now())
}

// ===== CODING TRACKS (Phase D) =====

enum ProblemStatus {
  ATTEMPTED
  SOLVED
}

// Per-user progress on a coding problem — rows exist only once attempted.
// SOLVED = a /code/submit that passed 100% of hidden tests.
model UserProblemStatus {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  problemId String
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status    ProblemStatus @default(ATTEMPTED)
  bestScore Float         @default(0) // 0..100, best weighted hidden-test score
  attempts  Int           @default(0)
  solvedAt  DateTime?
  updatedAt DateTime      @updatedAt

  @@unique([userId, problemId])
  @@index([userId, status])
}

// ===== HR & BEHAVIORAL BANK (Phase F) =====

model HrQuestion {
  id            String   @id @default(uuid())
  question      String
  category      String // intro | strengths | weakness | failure | conflict | teamwork | leadership | why-us | career-goals | pressure | situational
  starGuidance  String // markdown: how to structure the answer (STAR where applicable)
  sampleOutline String? // markdown: skeleton of a strong answer (never a script to memorize)
  companyTags   String[] @default([]) // company slugs that famously ask this
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([category])
}

// ===== UNIFIED DIAGNOSIS & AUTO-GENERATED QUESTS (Sprint 4) =====

model InterviewDiagnosis {
  id             String      @id @default(uuid())
  interviewId    String      @unique
  interview      AiInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  weakAreas      Json?
  strongAreas    Json?
  topicMappings  Json?
  overallVerdict String
  createdAt      DateTime    @default(now())
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   // "HR" | "TECH" | "CODING"
  description String
  milestones  Json     // [{ step: 1, text: "...", completed: false }]
  xpReward    Int      @default(100)
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED
  createdAt   DateTime @default(now())

  @@index([userId, status])
}

model PlacementDrive {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  resumeData        Json?
  status            String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  currentStep       String    @default("resume") // resume | hr | technical | coding | report
  hrInterviewId     String?
  techInterviewId   String?
  codingInterviewId String?
  overallScore      Float?
  overallVerdict    String?   // "Needs Practice" | "Almost Placement-Ready" | "Placement Ready"
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([userId, status])
}

// ===== PERSONALIZED LEARNING PIPELINE =====
// See plan.md "Plan Addendum: Personalized Learning Pipeline". A first-login
// diagnostic populates UserSkillProfile, which drives generation of a
// LearningPipeline of ordered PipelineStage rows with unlock gates.

// One profile per user — levels 0-5, 0 = not yet diagnosed for that pillar.
// Overall belt is derived from the average of the three diagnosed pillars.
model UserSkillProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aptitudeLevel  Int       @default(0) // 0=undiagnosed, 1=Foundations..5=Advanced
  coreCSLevel    Int       @default(0)
  codingLevel    Int       @default(0)
  commLevel      Int       @default(1) // starts at 1, grows from AI interview scores
  overallBelt    String    @default("Unranked") // Unranked | Bronze | Silver | Gold | Platinum | Diamond
  breakdown      Json?     // per-subtopic map — { "CN": 3, "OS": 2, "Arrays": 4, ... }
  diagnosticAt   DateTime? // null until first diagnostic completes
  lastRefreshAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Snapshot of a single diagnostic sitting. Kept for audit — retaking creates
// a new row rather than mutating history, so we can chart improvement.
model DiagnosticAttempt {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | EXPIRED
  itemsSnapshot   Json      // frozen question list at start (ids + kind + expected answers)
  responses       Json?     // { qId: { chosenIndex, correct, timeMs } } | { coding: { passed, total } }
  perPillarScores Json?     // { aptitude: 0.72, coreCS: 0.55, coding: 0.30 } 0..1
  levelsAwarded   Json?     // { aptitude: 4, coreCS: 3, coding: 2 } 1-5

  @@index([userId, status])
}

model LearningPipeline {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED
  focus         String    @default("balanced") // "balanced" | "placement-6w" | "coding-only"
  targetCompany String?   // optional slug — biases stage selection
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  stages        PipelineStage[]

  @@index([userId, status])
}

model PipelineStage {
  id           String    @id @default(uuid())
  pipelineId   String
  pipeline     LearningPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  order        Int       // 1..N — display + unlock order
  pillar       String    // "aptitude" | "coreCS" | "coding" | "comm"
  level        Int       // target level this stage moves the user toward (1-5)
  title        String
  description  String
  gateType     String    // "quiz" | "coding-solve" | "interview" | "theory-read"
  gateMeta     Json      // per gateType: { topicSlug, minScore, questionCount } | { problemIds, minSolved } etc.
  isUnlocked   Boolean   @default(false) // true once previous stage completed
  isCompleted  Boolean   @default(false)
  // Skipped ≠ completed. A skipped stage stays in the pipeline as "missed"
  // and the user can come back to complete it — only isCompleted counts as
  // progress. isSkipped clears when the stage is later completed via a gate.
  isSkipped    Boolean   @default(false)
  skippedAt    DateTime?
  completedAt  DateTime?

  @@unique([pipelineId, order])
  @@index([pipelineId, isCompleted])
}

// ===== COMPREHENSIVE TEST REPORTS =====
// See plan-comprehensive-reports.md. Reports snapshot one attempt (aptitude,
// core-CS, AI interview, coding, or placement drive) with per-mistake
// analysis + weak-concept tagging. ConceptSynopsis caches an LLM-generated
// explanation per (subject, concept) — shared across users and reports.

model TestReport {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType     String   // "core-cs-quiz" | "aptitude-quiz" | "ai-interview" | "coding-round" | "placement-drive"
  sourceId       String   // FK-like id into the underlying attempt row
  overallScore   Float
  perQuestion    Json     // [{ questionId, prompt, userAnswer, correctAnswer, isCorrect, explanation, conceptTag }]
  weakConcepts   Json     // [{ concept, subject, missCount, missedQuestionIds }]
  strongConcepts Json     // [{ concept, subject, correctCount }]
  createdAt      DateTime @default(now())

  @@index([userId, sourceType])
  @@index([sourceType, sourceId])
}

model ConceptSynopsis {
  id               String   @id @default(uuid())
  subject          String   // "OS" | "CN" | "DBMS" | "SQL" | "DSA" | "HR" | "Aptitude"
  concept          String   // "Virtual Memory" | "TCP 3-way handshake" | "Normalization 3NF"
  synopsis         String   // 4-8 sentence spoken-friendly explanation
  bulletKeys       String[] // 3-5 crisp bullet points
  commonMistakes   String?  // one sentence
  recommendedGames Json     // [{ gameType, topicSlug?, reason }]
  generatedBy      String   @default("groq")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([subject, concept])
}

// ===== PREP GAMES (Sprint 2 of plan-comprehensive-reports.md) =====
// Cached game content — STAR Roleplay uses this (LLM-generated 4-answer sets
// per HrQuestion). Complexity Sort + Time Rush derive from static data or
// existing tables and don't need rows here.
model GameContent {
  id         String   @id @default(uuid())
  gameType   String   // "STAR_ROLEPLAY" | "BUG_HUNT" | "DRY_RUN" | ...
  subject    String   // "HR" | "DSA" | ...
  refId      String?  // link back to source (e.g. HrQuestion.id for STAR Roleplay)
  payload    Json     // shape depends on gameType — see game pages
  difficulty String   @default("medium")
  source     String   @default("llm-groq") // "seed" | "llm-groq" | "llm-gemini"
  createdAt  DateTime @default(now())

  @@index([gameType, subject])
  @@index([gameType, refId])
}
